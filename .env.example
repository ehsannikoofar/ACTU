# Copy to .env and fill in. .env is gitignored — never commit real values.

# Where the app runs (used to build OAuth redirect URIs).
APP_BASE_URL=http://localhost:3000

# Epic on FHIR sandbox (non-production client IDs from fhir.epic.com > Build Apps).
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_CLINICIAN_CLIENT_ID=replace-with-non-production-client-id
EPIC_PATIENT_CLIENT_ID=replace-with-non-production-client-id

# "epic" = live Epic sandbox (requires the client IDs above).
# "offline" = bundled sample data, no Epic calls (for building / no-network rehearsals).
DATA_SOURCE=epic

# Optional: an Epic-hosted MCP server URL once Epic's incoming MCP connectors ship (announced for Q1 2027).
# Leave empty to use the built-in read-only FHIR MCP bridge.
EPIC_MCP_URL=

# Claude API (both agents). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=replace-with-your-key
CLAUDE_MODEL=claude-opus-5-5

